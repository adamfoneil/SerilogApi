@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView Policy="@PolicyName">
    <Authorized>
        @ChildContent
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">Access Denied</h4>
            <p>You do not have permission to access this resource.</p>
        </div>
    </NotAuthorized>
    <Authorizing>
        <div class="alert alert-info" role="alert">Checking authorization...</div>
    </Authorizing>
</AuthorizeView>

@code {
    [Parameter]
    public string? PolicyName { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

<style>
    .alert {
        padding: 12px 16px;
        border-radius: 4px;
        margin: 20px 0;
    }

    .alert-danger {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .alert-info {
        background: #d1ecf1;
        color: #0c5460;
        border: 1px solid #bee5eb;
    }

    .alert-heading {
        margin-top: 0;
        margin-bottom: 10px;
    }

    .alert p {
        margin-bottom: 0;
    }
</style>
